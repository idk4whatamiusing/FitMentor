import { ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    Avatar,
    BottomNav,
    Chip,
    ChoiceChip,
    Field,
    GhostButton,
    PrimaryButton,
    SectionLabel,
    StatBlock,
    ThemeToggle,
    TopBar,
    Wordmark,
} from "components.slint";

export struct MealItem {
    name: string,
    items: string,
    kcal: int,
    protein: int,
}

export struct WorkoutDay {
    day_index: int,
    title: string,
    focus: string,
    summary: string,
    completed: bool,
}

export struct ChatMessage {
    role: string,
    content: string,
}

export struct CommunityPost {
    id: string,
    author: string,
    text: string,
    likes: int,
    liked_by_me: bool,
    reply_count: int,
}

export component AppWindow inherits Window {
    in-out property <int> tab: 0;
    in-out property <bool> dark-mode: Palette.color-scheme == ColorScheme.dark;
    in-out property <int> water: 0;
    in-out property <int> sleep: 0;
    in-out property <int> steps: 0;
    in-out property <int> protein: 0;
    in-out property <string> user-name: "Friend";
    in-out property <bool> loading: false;
    in-out property <string> status-text: "Connect your account to sync today's log.";
    in-out property <bool> signed-in: false;
    in-out property <string> auth-token: "";
    in-out property <string> auth-error: "";
    in-out property <bool> google-busy: false;
    in-out property <string> auth-status: "";
    in-out property <string> profile-name: "Friend";
    in-out property <string> profile-email: "";
    in-out property <int> profile-age: 0;
    in-out property <int> profile-height: 0;
    in-out property <int> profile-weight: 0;
    in-out property <string> profile-goal: "";
    in-out property <string> profile-diet: "";
    in-out property <string> profile-place: "";
    in-out property <string> profile-experience: "";
    in-out property <int> profile-days: 0;
    in-out property <int> profile-budget: 0;
    in-out property <string> profile-tier: "Free";
    in-out property <bool> needs-onboarding: false;
    in-out property <string> form-name: "";
    in-out property <string> form-age: "22";
    in-out property <string> form-gender: "male";
    in-out property <string> form-height: "170";
    in-out property <string> form-weight: "65";
    in-out property <string> form-goal: "muscle_gain";
    in-out property <string> form-place: "gym";
    in-out property <string> form-experience: "beginner";
    in-out property <string> form-diet: "veg";
    in-out property <string> form-days: "4";
    in-out property <string> form-budget: "150";
    in-out property <string> form-error: "";
    in-out property <[MealItem]> nutrition-meals: [];
    in-out property <string> nutrition-title: "";
    in-out property <string> nutrition-status: "Load today's meal plan.";
    in-out property <int> target-calories: 0;
    in-out property <int> target-protein: 0;
    in-out property <int> target-carbs: 0;
    in-out property <int> target-fat: 0;
    in-out property <[WorkoutDay]> workout-days: [];
    in-out property <string> workout-status: "Load today's workout.";
    in-out property <[ChatMessage]> chat-messages: [];
    in-out property <string> chat-input: "";
    in-out property <string> chat-status: "Ask about training, food, or recovery.";
    in-out property <string> chat-session-id: "";
    in-out property <bool> chat-busy: false;
    in-out property <[CommunityPost]> community-posts: [];
    in-out property <string> community-input: "";
    in-out property <string> community-status: "Load the community feed.";
    in-out property <bool> community-busy: false;
    in-out property <string> community-open-id: "";
    in-out property <string> community-open-author: "";
    in-out property <string> community-open-text: "";
    in-out property <[CommunityPost]> community-replies: [];
    in-out property <string> community-reply-input: "";
    in-out property <string> community-reply-status: "";

    callback refresh();
    callback sign-in();
    callback google-sign-in();
    callback load-profile();
    callback sign-out();
    callback edit-profile();
    callback save-onboarding();
    callback skip-onboarding();
    callback load-nutrition();
    callback load-workout();
    callback complete-workout(int, string);
    callback load-chat();
    callback send-chat();
    callback new-chat();
    callback load-community();
    callback post-community();
    callback like-community(string);
    callback open-community-post(string);
    callback close-community-post();
    callback send-community-reply();
    callback checkout(string);
    callback add-water();
    callback add-steps();
    callback add-protein();
    callback set-tab(int);
    callback toggle-theme();

    title: "FitMentor";
    icon: @image-url("images/app-icon.png");
    width: 390px;
    height: 844px;
    background: Theme.bg;
    default-font-family: Theme.font-body;

    init => {
        Theme.dark = root.dark-mode;
    }

    changed dark-mode => {
        Theme.dark = root.dark-mode;
    }

    VerticalLayout {
        spacing: 0;

        TopBar {
            toggle-theme => {
                root.toggle-theme();
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                width: 100%;
                padding: 20px;
                spacing: 16px;

                // ------------------------------------------------------------
                // TODAY
                // ------------------------------------------------------------
                if root.tab == 0 : VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;

                        SectionLabel {
                            index: "01";
                            label: "TODAY";
                        }

                        Text {
                            text: "Hey, \{root.user-name}.";
                            color: Theme.text;
                            font-size: 34px;
                            font-weight: 600;
                            letter-spacing: -1.2px;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "One session, one plate, one glass at a time.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        height: 210px;
                        border-radius: 28px;
                        clip: true;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: @image-url("images/train-ropes.jpg");
                            image-fit: cover;
                        }

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: @linear-gradient(180deg, rgba(11, 11, 11, 0.10) 0%, rgba(11, 11, 11, 0.86) 100%);
                        }

                        VerticalLayout {
                            padding: 20px;
                            spacing: 6px;
                            alignment: end;

                            Text {
                                text: "TODAY'S SESSION";
                                color: Theme.accent;
                                font-size: 9px;
                                font-weight: 700;
                                letter-spacing: 1.6px;
                            }

                            Text {
                                text: root.workout-days.length > 0 ? root.workout-days[0].title : "Your first session";
                                color: Theme.cream;
                                font-size: 26px;
                                font-weight: 600;
                                letter-spacing: -0.6px;
                            }

                            Text {
                                text: root.workout-days.length > 0 ? root.workout-days[0].focus : "Build the habit first.";
                                color: rgba(247, 243, 237, 0.62);
                                font-size: 12px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        StatBlock {
                            label: "WATER";
                            value: "\{root.water}";
                            unit: "glasses";
                        }

                        StatBlock {
                            label: "STEPS";
                            value: "\{root.steps}";
                            unit: "today";
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        StatBlock {
                            label: "PROTEIN";
                            value: "\{root.protein}";
                            unit: "g";
                            highlight: true;
                        }

                        StatBlock {
                            label: "SLEEP";
                            value: "\{root.sleep}";
                            unit: "h";
                        }
                    }

                    Rectangle {
                        border-radius: 24px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            SectionLabel {
                                label: "QUICK LOG";
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                GhostButton {
                                    label: "+ Water";
                                    clicked => {
                                        root.add-water();
                                    }
                                }

                                GhostButton {
                                    label: "+ Steps";
                                    clicked => {
                                        root.add-steps();
                                    }
                                }

                                GhostButton {
                                    label: "+ Protein";
                                    clicked => {
                                        root.add-protein();
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: space-between;

                        Text {
                            text: root.status-text;
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        GhostButton {
                            label: root.loading ? "Syncing…" : "Refresh";
                            width: 88px;
                            clicked => {
                                root.refresh();
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // FOOD
                // ------------------------------------------------------------
                if root.tab == 1 : VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;

                        SectionLabel {
                            index: "02";
                            label: "FUEL";
                        }

                        Text {
                            text: "Eat for the work.";
                            color: Theme.text;
                            font-size: 34px;
                            font-weight: 600;
                            letter-spacing: -1.2px;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Indian food, your budget, your protein target.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        border-radius: 24px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 16px;

                            SectionLabel {
                                label: "DAILY TARGETS";
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: "\{root.target-calories}";
                                        color: Theme.text;
                                        font-size: 22px;
                                        font-weight: 500;
                                    }
                                    Text {
                                        text: "KCAL";
                                        color: Theme.muted;
                                        font-size: 8px;
                                        letter-spacing: 1px;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: "\{root.target-protein}";
                                        color: Theme.accent;
                                        font-size: 22px;
                                        font-weight: 500;
                                    }
                                    Text {
                                        text: "PROTEIN";
                                        color: Theme.muted;
                                        font-size: 8px;
                                        letter-spacing: 1px;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: "\{root.target-carbs}";
                                        color: Theme.text;
                                        font-size: 22px;
                                        font-weight: 500;
                                    }
                                    Text {
                                        text: "CARBS";
                                        color: Theme.muted;
                                        font-size: 8px;
                                        letter-spacing: 1px;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: "\{root.target-fat}";
                                        color: Theme.text;
                                        font-size: 22px;
                                        font-weight: 500;
                                    }
                                    Text {
                                        text: "FAT";
                                        color: Theme.muted;
                                        font-size: 8px;
                                        letter-spacing: 1px;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: space-between;

                        Text {
                            text: root.nutrition-status;
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }

                        GhostButton {
                            label: "Refresh";
                            width: 88px;
                            clicked => {
                                root.load-nutrition();
                            }
                        }
                    }

                    if root.nutrition-meals.length == 0 : Rectangle {
                        height: 120px;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Theme.line;

                        Text {
                            text: "No meal plan yet. It appears after the daily planner runs.";
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            x: 24px;
                            y: 0;
                            width: parent.width - 48px;
                            height: 100%;
                        }
                    }

                    for meal in root.nutrition-meals : Rectangle {
                        border-radius: 22px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;

                            HorizontalLayout {
                                Text {
                                    text: meal.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "\{meal.kcal} kcal";
                                    color: Theme.accent;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: meal.items;
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "\{meal.protein} g protein";
                                color: Theme.text;
                                font-size: 10px;
                                font-weight: 600;
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // TRAIN
                // ------------------------------------------------------------
                if root.tab == 2 : VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;

                        SectionLabel {
                            index: "03";
                            label: "TRAIN";
                        }

                        Text {
                            text: "The week.";
                            color: Theme.text;
                            font-size: 34px;
                            font-weight: 600;
                            letter-spacing: -1.2px;
                        }

                        Text {
                            text: "Built around your equipment and schedule.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: space-between;

                        Text {
                            text: root.workout-status;
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }

                        GhostButton {
                            label: "Refresh";
                            width: 88px;
                            clicked => {
                                root.load-workout();
                            }
                        }
                    }

                    if root.workout-days.length == 0 : Rectangle {
                        height: 120px;
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: Theme.line;

                        Text {
                            text: "No workout plan yet. It appears after the daily planner runs.";
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            x: 24px;
                            y: 0;
                            width: parent.width - 48px;
                            height: 100%;
                        }
                    }

                    for day in root.workout-days : Rectangle {
                        border-radius: 24px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 10px;

                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 14px;
                                    background: day.completed ? Theme.accent : Theme.surface-2;

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: "\{day.day_index + 1}";
                                        color: day.completed ? Theme.ink : Theme.muted;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "DAY \{day.day_index + 1}";
                                        color: Theme.muted;
                                        font-size: 8px;
                                        font-weight: 600;
                                        letter-spacing: 1.2px;
                                    }
                                    Text {
                                        text: day.title;
                                        color: Theme.text;
                                        font-size: 16px;
                                        font-weight: 600;
                                    }
                                }

                                if day.completed : Text {
                                    text: "DONE";
                                    color: Theme.accent;
                                    font-size: 9px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: day.focus;
                                color: Theme.accent;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            Text {
                                text: day.summary;
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            GhostButton {
                                label: day.completed ? "Completed" : "Mark day complete";
                                active: day.completed;
                                clicked => {
                                    if !day.completed {
                                        root.complete-workout(day.day_index, day.title);
                                    }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // COACH
                // ------------------------------------------------------------
                if root.tab == 3 : VerticalLayout {
                    spacing: 14px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;

                            SectionLabel {
                                index: "04";
                                label: "COACH";
                            }

                            Text {
                                text: "Ask the coach.";
                                color: Theme.text;
                                font-size: 34px;
                                font-weight: 600;
                                letter-spacing: -1.2px;
                            }
                        }

                        GhostButton {
                            label: "New chat";
                            width: 92px;
                            clicked => {
                                root.new-chat();
                            }
                        }
                    }

                    Text {
                        text: root.chat-status;
                        color: Theme.muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    ScrollView {
                        height: 420px;

                        VerticalLayout {
                            width: 100%;
                            spacing: 8px;

                            if root.chat-messages.length == 0 : Text {
                                text: "Training, food, recovery, or the week you just missed. Start anywhere.";
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            for message in root.chat-messages : Rectangle {
                                border-radius: 20px;
                                background: message.role == "assistant" ? Theme.surface : Theme.text;
                                border-width: message.role == "assistant" ? 1px : 0px;
                                border-color: Theme.line;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 6px;

                                    if message.role == "assistant" : Text {
                                        text: "COACH";
                                        color: Theme.accent;
                                        font-size: 8px;
                                        font-weight: 700;
                                        letter-spacing: 1.4px;
                                    }

                                    Text {
                                        text: message.content;
                                        color: message.role == "assistant" ? Theme.text : Theme.cream;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 48px;
                            border-radius: 24px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.line;

                            Text {
                                x: 16px;
                                y: 0;
                                width: parent.width - 32px;
                                height: 100%;
                                text: "Ask your coach…";
                                color: Theme.muted;
                                font-size: 13px;
                                vertical-alignment: center;
                                visible: root.chat-input == "";
                            }

                            TextInput {
                                x: 16px;
                                y: 0;
                                width: parent.width - 32px;
                                height: 100%;
                                text <=> root.chat-input;
                                single-line: true;
                                color: Theme.text;
                                font-size: 13px;
                                vertical-alignment: center;
                                accepted => {
                                    root.send-chat();
                                }
                            }
                        }

                        GhostButton {
                            label: root.chat-busy ? "…" : "Send";
                            width: 68px;
                            clicked => {
                                root.send-chat();
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // YOU
                // ------------------------------------------------------------
                if root.tab == 4 : VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 14px;

                        Avatar {
                            initials: "FM";
                            size: 64;
                        }

                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;

                            SectionLabel {
                                index: "05";
                                label: "YOU";
                            }

                            Text {
                                text: root.profile-name;
                                color: Theme.text;
                                font-size: 28px;
                                font-weight: 600;
                                letter-spacing: -0.8px;
                            }

                            Text {
                                text: root.profile-email;
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 28px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;

                            SectionLabel {
                                label: "CURRENT PLAN";
                            }

                            Text {
                                text: root.profile-tier;
                                color: Theme.accent;
                                font-size: 30px;
                                font-weight: 600;
                                letter-spacing: -0.8px;
                            }

                            Text {
                                text: "Goal: \{root.profile-goal}  ·  \{root.profile-diet}  ·  \{root.profile-days}× / week";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                GhostButton {
                                    label: "Basic ₹99";
                                    clicked => {
                                        root.checkout("pro");
                                    }
                                }

                                GhostButton {
                                    label: "Elite ₹299";
                                    clicked => {
                                        root.checkout("premium");
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        StatBlock {
                            label: "AGE";
                            value: "\{root.profile-age}";
                            unit: "yrs";
                        }

                        StatBlock {
                            label: "HEIGHT";
                            value: "\{root.profile-height}";
                            unit: "cm";
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        StatBlock {
                            label: "WEIGHT";
                            value: "\{root.profile-weight}";
                            unit: "kg";
                        }

                        StatBlock {
                            label: "BUDGET";
                            value: "₹\{root.profile-budget}";
                            unit: "/ day";
                        }
                    }

                    Rectangle {
                        border-radius: 24px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;

                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "Theme";
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                ThemeToggle {
                                    clicked => {
                                        root.toggle-theme();
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            GhostButton {
                                label: "Edit profile";
                                clicked => {
                                    root.edit-profile();
                                }
                            }

                            GhostButton {
                                label: "Refresh profile";
                                clicked => {
                                    root.load-profile();
                                }
                            }

                            GhostButton {
                                label: "Sign out";
                                clicked => {
                                    root.sign-out();
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------------------
                // FEED
                // ------------------------------------------------------------
                if root.tab == 5 : VerticalLayout {
                    spacing: 16px;
                    alignment: start;

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;

                        SectionLabel {
                            index: "06";
                            label: "FEED";
                        }

                        Text {
                            text: "The floor.";
                            color: Theme.text;
                            font-size: 34px;
                            font-weight: 600;
                            letter-spacing: -1.2px;
                        }

                        Text {
                            text: "Wins, questions, and the days nobody feels like training.";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;

                        Text {
                            text: root.community-status;
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }

                        GhostButton {
                            label: "Refresh";
                            width: 88px;
                            clicked => {
                                root.load-community();
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 24px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            TextInput {
                                height: 64px;
                                text <=> root.community-input;
                                single-line: false;
                                wrap: word-wrap;
                                color: Theme.text;
                                font-size: 13px;
                            }

                            HorizontalLayout {
                                alignment: space-between;

                                Text {
                                    text: "Keep it useful or keep it kind.";
                                    color: Theme.muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }

                                GhostButton {
                                    label: root.community-busy ? "Posting…" : "Post";
                                    width: 84px;
                                    clicked => {
                                        root.post-community();
                                    }
                                }
                            }
                        }
                    }

                    if root.community-posts.length == 0 : Text {
                        text: "No posts yet. Start the conversation.";
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    for post in root.community-posts : Rectangle {
                        border-radius: 22px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;

                                Avatar {
                                    initials: "U";
                                    size: 32;
                                }

                                Text {
                                    text: post.author;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            Text {
                                text: post.text;
                                color: Theme.text;
                                font-size: 14px;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                GhostButton {
                                    label: post.liked_by_me ? "♥ \{post.likes}" : "♡ \{post.likes}";
                                    width: 84px;
                                    active: post.liked_by_me;
                                    clicked => {
                                        root.like-community(post.id);
                                    }
                                }

                                GhostButton {
                                    label: "\{post.reply_count} replies";
                                    width: 100px;
                                    clicked => {
                                        root.open-community-post(post.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        BottomNav {
            active: root.tab;
            select(tab) => {
                root.set-tab(tab);
            }
        }
    }

    // ----------------------------------------------------------------
    // Sign in
    // ----------------------------------------------------------------
    if !root.signed-in : Rectangle {
        background: Theme.bg;

        ScrollView {
            width: 100%;
            height: 100%;

            VerticalLayout {
                width: 100%;
                spacing: 0;

                Rectangle {
                    height: 290px;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: @image-url("images/auth-gym.jpg");
                        image-fit: cover;
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: @linear-gradient(180deg, rgba(11, 11, 11, 0.30) 0%, rgba(11, 11, 11, 0.92) 100%);
                    }

                    VerticalLayout {
                        padding: 24px;
                        alignment: space-between;

                        Wordmark {
                            on-dark: true;
                        }

                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "TRAIN LIKE YOU MEAN IT.";
                                color: Theme.cream;
                                font-size: 30px;
                                font-weight: 600;
                                letter-spacing: -1px;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "AI coaching, Indian meals, and a plan that fits your week.";
                                color: rgba(247, 243, 237, 0.6);
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    alignment: start;

                    SectionLabel {
                        index: "01";
                        label: "SIGN IN";
                    }

                    Text {
                        text: "Connect your account.";
                        color: Theme.text;
                        font-size: 28px;
                        font-weight: 600;
                        letter-spacing: -0.8px;
                    }

                    Text {
                        text: "Sign in with Google in your browser. You'll come back here when you're done.";
                        color: Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    PrimaryButton {
                        label: root.google-busy ? "Waiting for Google…" : "Continue with Google";
                        enabled: !root.google-busy;
                        clicked => {
                            root.google-sign-in();
                        }
                    }

                    Text {
                        text: root.auth-status;
                        color: Theme.accent;
                        font-size: 11px;
                        wrap: word-wrap;
                        visible: root.auth-status != "";
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }

                    Text {
                        text: "OR PASTE A MOBILE TOKEN";
                        color: Theme.muted;
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 1.2px;
                    }

                    Field {
                        label: "Token";
                        placeholder: "Paste the token from the API";
                        text <=> root.auth-token;
                    }

                    GhostButton {
                        label: "Continue";
                        clicked => {
                            root.sign-in();
                        }
                    }

                    Text {
                        text: root.auth-error;
                        color: #E5484D;
                        font-size: 12px;
                        wrap: word-wrap;
                        visible: root.auth-error != "";
                    }
                }
            }
        }
    }

    // ----------------------------------------------------------------
    // Onboarding
    // ----------------------------------------------------------------
    if root.needs-onboarding : Rectangle {
        background: Theme.bg;

        ScrollView {
            width: 100%;
            height: 100%;

            VerticalLayout {
                width: 100%;
                padding: 24px;
                spacing: 16px;
                alignment: start;

                SectionLabel {
                    index: "01";
                    label: "SETUP";
                }

                Text {
                    text: "Build your first week.";
                    color: Theme.text;
                    font-size: 32px;
                    font-weight: 600;
                    letter-spacing: -1px;
                    wrap: word-wrap;
                }

                Text {
                    text: "Nine answers become your training split, daily targets, and meal plan.";
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Field {
                    label: "NAME";
                    placeholder: "Your first name";
                    text <=> root.form-name;
                }

                HorizontalLayout {
                    spacing: 10px;

                    Field {
                        label: "AGE";
                        text <=> root.form-age;
                    }

                    Field {
                        label: "HEIGHT (CM)";
                        text <=> root.form-height;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;

                    Field {
                        label: "WEIGHT (KG)";
                        text <=> root.form-weight;
                    }

                    Field {
                        label: "DAYS / WEEK";
                        text <=> root.form-days;
                    }
                }

                Field {
                    label: "FOOD BUDGET (₹ / DAY)";
                    text <=> root.form-budget;
                }

                Text {
                    text: "GENDER";
                    color: Theme.muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                }

                HorizontalLayout {
                    spacing: 6px;

                    ChoiceChip {
                        label: "Male";
                        active: root.form-gender == "male";
                        clicked => { root.form-gender = "male"; }
                    }
                    ChoiceChip {
                        label: "Female";
                        active: root.form-gender == "female";
                        clicked => { root.form-gender = "female"; }
                    }
                    ChoiceChip {
                        label: "Other";
                        active: root.form-gender == "other";
                        clicked => { root.form-gender = "other"; }
                    }
                }

                Text {
                    text: "GOAL";
                    color: Theme.muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                }

                HorizontalLayout {
                    spacing: 6px;

                    ChoiceChip {
                        label: "Muscle";
                        active: root.form-goal == "muscle_gain";
                        clicked => { root.form-goal = "muscle_gain"; }
                    }
                    ChoiceChip {
                        label: "Fat loss";
                        active: root.form-goal == "fat_loss";
                        clicked => { root.form-goal = "fat_loss"; }
                    }
                    ChoiceChip {
                        label: "Strength";
                        active: root.form-goal == "strength";
                        clicked => { root.form-goal = "strength"; }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    ChoiceChip {
                        label: "Recomp";
                        active: root.form-goal == "recomp";
                        clicked => { root.form-goal = "recomp"; }
                    }
                    ChoiceChip {
                        label: "Stay fit";
                        active: root.form-goal == "general";
                        clicked => { root.form-goal = "general"; }
                    }
                }

                Text {
                    text: "WHERE DO YOU TRAIN?";
                    color: Theme.muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                }

                HorizontalLayout {
                    spacing: 6px;

                    ChoiceChip {
                        label: "Gym";
                        active: root.form-place == "gym";
                        clicked => { root.form-place = "gym"; }
                    }
                    ChoiceChip {
                        label: "Home";
                        active: root.form-place == "home";
                        clicked => { root.form-place = "home"; }
                    }
                }

                Text {
                    text: "EXPERIENCE";
                    color: Theme.muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                }

                HorizontalLayout {
                    spacing: 6px;

                    ChoiceChip {
                        label: "Beginner";
                        active: root.form-experience == "beginner";
                        clicked => { root.form-experience = "beginner"; }
                    }
                    ChoiceChip {
                        label: "Intermediate";
                        active: root.form-experience == "intermediate";
                        clicked => { root.form-experience = "intermediate"; }
                    }
                    ChoiceChip {
                        label: "Advanced";
                        active: root.form-experience == "advanced";
                        clicked => { root.form-experience = "advanced"; }
                    }
                }

                Text {
                    text: "DIET";
                    color: Theme.muted;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1.2px;
                }

                HorizontalLayout {
                    spacing: 6px;

                    ChoiceChip {
                        label: "Veg";
                        active: root.form-diet == "veg";
                        clicked => { root.form-diet = "veg"; }
                    }
                    ChoiceChip {
                        label: "Non-veg";
                        active: root.form-diet == "nonveg";
                        clicked => { root.form-diet = "nonveg"; }
                    }
                    ChoiceChip {
                        label: "Egg";
                        active: root.form-diet == "egg";
                        clicked => { root.form-diet = "egg"; }
                    }
                }

                Text {
                    text: root.form-error;
                    color: #E5484D;
                    font-size: 12px;
                    wrap: word-wrap;
                    visible: root.form-error != "";
                }

                PrimaryButton {
                    label: "Save profile";
                    clicked => {
                        root.save-onboarding();
                    }
                }

                GhostButton {
                    label: "Skip for now";
                    clicked => {
                        root.skip-onboarding();
                    }
                }

                Rectangle {
                    height: 16px;
                }
            }
        }
    }

    // ----------------------------------------------------------------
    // Community thread
    // ----------------------------------------------------------------
    if root.community-open-id != "" : Rectangle {
        background: Theme.bg;

        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            alignment: start;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "Thread";
                    color: Theme.text;
                    font-size: 30px;
                    font-weight: 600;
                    letter-spacing: -0.8px;
                    vertical-alignment: center;
                }

                GhostButton {
                    label: "Close";
                    width: 84px;
                    clicked => {
                        root.close-community-post();
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    width: 100%;
                    spacing: 12px;

                    Rectangle {
                        border-radius: 22px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;

                            Text {
                                text: root.community-open-author;
                                color: Theme.accent;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1px;
                            }

                            Text {
                                text: root.community-open-text;
                                color: Theme.text;
                                font-size: 15px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if root.community-replies.length == 0 : Text {
                        text: "No replies yet. Add the first one.";
                        color: Theme.muted;
                        font-size: 12px;
                    }

                    for reply in root.community-replies : Rectangle {
                        border-radius: 18px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.line;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;

                            Text {
                                text: reply.author;
                                color: Theme.accent;
                                font-size: 9px;
                                font-weight: 700;
                                letter-spacing: 1px;
                            }

                            Text {
                                text: reply.text;
                                color: Theme.text;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 48px;
                    border-radius: 24px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.line;

                    TextInput {
                        x: 16px;
                        y: 0;
                        width: parent.width - 32px;
                        height: 100%;
                        text <=> root.community-reply-input;
                        single-line: true;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        accepted => {
                            root.send-community-reply();
                        }
                    }
                }

                GhostButton {
                    label: "Reply";
                    width: 76px;
                    clicked => {
                        root.send-community-reply();
                    }
                }
            }

            Text {
                text: root.community-reply-status;
                color: #E5484D;
                font-size: 11px;
                wrap: word-wrap;
                visible: root.community-reply-status != "";
            }
        }
    }
}
