// Shared components mirrored from the mobile web UI.

import { Theme } from "theme.slint";

export component Icon inherits Rectangle {
    in property <length> size: 18px;
    in property <color> tint: Theme.text;
    in property <image> source;

    width: root.size;
    height: root.size;
    background: transparent;

    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        colorize: root.tint;
        image-fit: contain;
    }
}

export component Wordmark inherits Rectangle {
    in property <bool> on-dark: false;

    height: 16px;
    width: word.width + 10px;

    word := Text {
        x: 0;
        y: 0;
        text: "FITMENTOR";
        color: root.on-dark ? Theme.cream : Theme.text;
        font-family: Theme.font-wordmark;
        font-size: 12px;
        letter-spacing: 1.6px;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 5px;
        y: 9px;
        width: 5px;
        height: 5px;
        background: Theme.accent;
    }
}

export component SectionLabel inherits HorizontalLayout {
    in property <string> index: "";
    in property <string> label: "";
    in property <bool> on-dark: false;

    height: 14px;
    spacing: 8px;
    alignment: start;
    horizontal-stretch: 1;

    Text {
        text: root.index;
        color: Theme.accent;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1.4px;
        vertical-alignment: center;
        visible: root.index != "";
    }

    Rectangle {
        width: root.index == "" ? 0px : 24px;
        height: 1px;
        background: root.on-dark ? rgba(247, 243, 237, 0.24) : Theme.line;
    }

    Text {
        text: root.label;
        color: root.on-dark ? rgba(247, 243, 237, 0.52) : Theme.muted;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1.4px;
        horizontal-stretch: 1;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component Pill inherits Rectangle {
    in property <string> label: "";
    in property <bool> accent: false;
    in property <bool> on-dark: false;
    in property <bool> dot: false;

    height: 26px;
    width: self.preferred-width;
    border-radius: 13px;
    background: root.accent ? Theme.accent : transparent;
    border-width: root.accent ? 0px : 1px;
    border-color: root.on-dark ? rgba(247, 243, 237, 0.22) : Theme.line;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;

        Rectangle {
            width: root.dot ? 5px : 0px;
            height: 5px;
            border-radius: 3px;
            background: root.accent ? Theme.ink : Theme.accent;
            visible: root.dot;
        }

        Text {
            text: root.label;
            color: root.accent ? Theme.ink : (root.on-dark ? Theme.cream : Theme.text);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.3px;
            vertical-alignment: center;
        }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <bool> on-dark: false;
    callback clicked();

    width: 100%;
    height: 48px;
    border-radius: 24px;
    background: root.enabled
        ? (root.on-dark ? Theme.cream : (Theme.dark ? Theme.cream : Theme.text))
        : (root.on-dark ? rgba(247, 243, 237, 0.25) : rgba(11, 11, 11, 0.25));

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 6px;
        alignment: space-between;

        Text {
            text: root.label;
            color: root.on-dark ? Theme.ink : (Theme.dark ? Theme.ink : Theme.cream);
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: Theme.accent;

            Icon {
                x: 10px;
                y: 10px;
                size: 16px;
                tint: Theme.ink;
                source: @image-url("icons/arrow-up-right.png");
            }
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component SmallPrimary inherits Rectangle {
    in property <string> label: "";
    callback clicked();

    width: 150px;
    height: 48px;
    border-radius: 24px;
    background: Theme.dark ? Theme.cream : Theme.ink;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 6px;
        alignment: space-between;
        Text {
            text: root.label;
            color: Theme.dark ? Theme.ink : Theme.cream;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: Theme.accent;
            Icon { x: 10px; y: 10px; size: 16px; tint: Theme.ink; source: @image-url("icons/arrow-up-right.png"); }
        }
    }

    TouchArea { width: 100%; height: 100%; clicked => { root.clicked(); } }
}

export component GhostButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> stretch: true;
    in property <bool> show-icon: false;
    in property <image> icon;
    callback clicked();

    horizontal-stretch: root.stretch ? 1 : 0;
    height: 40px;
    border-radius: 20px;
    background: root.active ? Theme.accent-soft : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.line;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;

        Icon {
            size: 14px;
            tint: root.active ? Theme.accent : Theme.muted;
            source: root.icon;
            visible: root.show-icon;
        }

        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.muted;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}

