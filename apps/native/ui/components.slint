}

export component Avatar inherits Rectangle {
    in property <string> initials: "";
    in property <int> size: 56;

    width: root.size * 1px;
    height: root.size * 1px;
    border-radius: root.size * 0.3px;
    background: Theme.accent;

    Text {
        width: 100%;
        height: 100%;
        text: root.initials;
        color: Theme.ink;
        font-family: Theme.font-wordmark;
        font-size: root.size * 0.24px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SliderTrack inherits Rectangle {
    in-out property <int> value: 0;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    callback changed(int);

    height: 20px;
    background: transparent;

    Rectangle {
        y: 7px;
        width: 100%;
        height: 6px;
        border-radius: 3px;
        background: Theme.dark ? #2B2B2B : #EBEBEB;
    }

    Rectangle {
        y: 7px;
        width: parent.width * (max(0, min(100, (root.value - root.minimum) * 100.0 / max(1, root.maximum - root.minimum))) / 100.0);
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }

    Rectangle {
        x: parent.width * (max(0, min(100, (root.value - root.minimum) * 100.0 / max(1, root.maximum - root.minimum))) / 100.0) - 8px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.accent;
        border-width: 2px;
        border-color: Theme.surface;
    }

    TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            set-from-x(self.mouse-x);
        }

        moved => {
            if self.pressed {
                set-from-x(self.mouse-x);
            }
        }

        function set-from-x(x: length) {
            if (root.width <= 0px) {
                return;
            }
            let ratio = max(0, min(1, x / root.width));
            let raw = root.minimum + ratio * (root.maximum - root.minimum);
            let stepped = round(raw / root.step) * root.step;
            root.value = round(stepped);
            root.changed(root.value);
        }
    }
}

export component SupplementRow inherits VerticalLayout {
    in property <string> name: "";
    in property <string> inr: "";
    in property <string> when: "";
    in property <string> why: "";
    in property <string> natural: "";
    in property <bool> open: false;
    callback toggle();

    spacing: 0;

    Rectangle {
        height: 56px;
        background: transparent;

        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                Text { text: root.name; color: Theme.text; font-size: 14px; font-weight: 500; }
                Text { text: root.inr; color: Theme.muted; font-size: 11px; }
            }
            Text { text: root.open ? "−" : "+"; color: Theme.muted; font-size: 20px; vertical-alignment: center; }
        }

        TouchArea { width: 100%; height: 100%; clicked => { root.toggle(); } }
    }

    if root.open : VerticalLayout {
        spacing: 4px;
        padding-bottom: 12px;
        Text { text: "When: " + root.when; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        Text { text: "Why: " + root.why; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        Text { text: "Natural sources: " + root.natural; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        Text { text: "Check the expiry before buying."; color: Theme.muted; font-size: 11px; }
    }

    Rectangle { height: 1px; background: Theme.line; }
}

export component Feature inherits HorizontalLayout {
    in property <string> label: "";

    spacing: 8px;
    alignment: start;

    Icon { size: 13px; tint: Theme.accent; source: @image-url("icons/check.png"); }
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 11px;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}
