export component TopBar inherits Rectangle {
    callback toggle-theme;

    height: Theme.header-h;
    background: Theme.bg;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 16px;
        alignment: space-between;
        cross-axis-alignment: center;

        Wordmark {}

        IconButton {
            icon: Theme.dark ? @image-url("icons/sun.png") : @image-url("icons/moon.png");
            clicked => {
                root.toggle-theme();
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.line;
    }
}

component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> accent: false;
    callback clicked();

    horizontal-stretch: 1;

    VerticalLayout {
        width: parent.width;
        spacing: 4px;
        alignment: center;

        Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: root.active
                ? (root.accent ? Theme.accent : (Theme.dark ? Theme.cream : Theme.ink))
                : transparent;

            Icon {
                x: 6px;
                y: 6px;
                size: 18px;
                tint: root.active
                    ? (root.accent ? Theme.ink : (Theme.dark ? Theme.ink : Theme.cream))
                    : Theme.muted;
                source: root.icon;
            }
        }

        Text {
            width: 50px;
            text: root.label;
            color: root.active ? Theme.text : Theme.muted;
            font-size: 9px;
            font-weight: root.active ? 700 : 600;
            letter-spacing: 0.8px;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}

export component BottomNav inherits Rectangle {
    in property <int> active: 0;
    callback select(int);

    height: 72px;
    border-radius: 0px;
    background: Theme.surface;
    border-width: 0px;
    border-color: transparent;

    Rectangle {
        y: 0;
        width: 100%;
        height: 1px;
        background: Theme.line;
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 0;

        NavItem {
            label: "HOME";
            icon: @image-url("icons/house.png");
            active: root.active == 0;
            clicked => { root.select(0); }
        }
        NavItem {
            label: "TRAIN";
            icon: @image-url("icons/dumbbell.png");
            active: root.active == 1;
            clicked => { root.select(1); }
        }
        NavItem {
            label: "FOOD";
            icon: @image-url("icons/apple.png");
            active: root.active == 2;
            clicked => { root.select(2); }
        }
        NavItem {
            label: "COACH";
            icon: @image-url("icons/sparkles.png");
            active: root.active == 3;
            accent: true;
            clicked => { root.select(3); }
        }
        NavItem {
            label: "TOOLS";
            icon: @image-url("icons/wrench.png");
            active: root.active == 4;
            clicked => { root.select(4); }
        }
        NavItem {
            label: "YOU";
            icon: @image-url("icons/user.png");
            active: root.active == 5;
            clicked => { root.select(5); }
        }
    }
}

