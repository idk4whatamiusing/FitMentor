export component ChoiceCard inherits Rectangle {
    in property <string> index: "";
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked();

    width: 100%;
    height: 64px;
    border-radius: 20px;
    background: root.selected ? Theme.accent-soft : Theme.surface;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.line;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 14px;

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: root.selected ? Theme.accent : Theme.surface-2;

            Text {
                width: 100%;
                height: 100%;
                text: root.index;
                color: root.selected ? Theme.ink : Theme.muted;
                font-family: Theme.font-wordmark;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-size: 15px;
            font-weight: 500;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: root.selected ? Theme.text : transparent;
            border-width: root.selected ? 0px : 1px;
            border-color: Theme.line;

            Icon {
                x: 7px;
                y: 7px;
                size: 14px;
                tint: root.selected ? (Theme.dark ? Theme.ink : Theme.cream) : Theme.line-strong;
                source: @image-url("icons/arrow-up-right.png");
            }
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}

export component StatBlock inherits Rectangle {
    horizontal-stretch: 1;
    in property <string> label: "";
    in property <string> value: "";
    in property <string> unit: "";
    in property <string> hint: "";
    in property <int> progress: -1;
    in property <bool> invert: false;
    in property <bool> highlight: false;

    height: 112px;
    min-width: 0px;
    border-radius: 24px;
    background: root.invert ? Theme.ink : Theme.surface;
    border-width: 1px;
    border-color: root.invert ? rgba(247, 243, 237, 0.14) : Theme.line;

    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        min-width: 0px;

        Text {
            text: root.label;
            color: root.invert ? rgba(247, 243, 237, 0.5) : Theme.muted;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.8px;
        }

        HorizontalLayout {
            spacing: 4px;
            alignment: start;

            Text {
                text: root.value;
                color: root.highlight ? Theme.accent : (root.invert ? Theme.cream : Theme.text);
                font-size: 32px;
                font-weight: 500;
                letter-spacing: -1px;
                vertical-alignment: bottom;
            }

            Text {
                text: root.unit;
                color: root.invert ? rgba(247, 243, 237, 0.5) : Theme.muted;
                font-size: 12px;
                vertical-alignment: bottom;
            }
        }

        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: root.invert ? rgba(247, 243, 237, 0.16) : (Theme.dark ? #2B2B2B : #EBEBEB);
            visible: root.progress >= 0;

            Rectangle {
                width: parent.width * (root.progress / 100.0);
                height: 100%;
                border-radius: 3px;
                background: Theme.accent;
            }
        }

        Text {
            text: root.hint;
            color: root.invert ? rgba(247, 243, 237, 0.6) : Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            visible: root.hint != "" && root.progress < 0;
        }
    }
}

export component ProgressBar inherits Rectangle {
    in property <int> value: 0;
    in property <bool> ink: false;

    height: 6px;
    border-radius: 3px;
    background: Theme.dark ? #2B2B2B : #EBEBEB;

    Rectangle {
        width: parent.width * (max(0, min(100, root.value)) / 100);
        height: 100%;
        border-radius: 3px;
        background: root.ink ? (Theme.dark ? Theme.cream : Theme.text) : Theme.accent;
    }
}

export component Field inherits VerticalLayout {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> text;

    spacing: 6px;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.6px;
    }

    Rectangle {
        height: 40px;
        border-radius: 12px;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.line;

        Text {
            x: 14px;
            y: 0;
            width: parent.width - 28px;
            height: 100%;
            text: root.placeholder;
            color: Theme.muted;
            font-size: 14px;
            vertical-alignment: center;
            visible: root.text == "";
        }

        TextInput {
            x: 14px;
            y: 0;
            width: parent.width - 28px;
            height: 100%;
            text <=> root.text;
            single-line: true;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
}

export component BigField inherits VerticalLayout {
