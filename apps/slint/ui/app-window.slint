import { ScrollView } from "std-widgets.slint";

export struct MealItem {
    name: string,
    items: string,
    kcal: int,
    protein: int,
}

component StatCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <color> accent: #38bdf8;

    horizontal-stretch: 1;
    height: 86px;
    border-radius: 16px;
    background: #0d1622;
    border-width: 1px;
    border-color: #1e293b;

    VerticalLayout {
        padding: 12px;
        spacing: 4px;

        Text {
            text: root.title;
            color: #94a3b8;
            font-size: 11px;
        }
        Text {
            text: root.value;
            color: root.accent;
            font-size: 18px;
            font-weight: 700;
        }
    }
}

component QuickButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    horizontal-stretch: 1;
    height: 44px;
    border-radius: 12px;
    background: #0f2233;
    border-width: 1px;
    border-color: #1e3a5f;

    Text {
        text: root.label;
        color: #bae6fd;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    horizontal-stretch: 1;
    border-radius: 14px;
    background: root.active ? #11243a : transparent;

    Text {
        text: root.label;
        color: root.active ? #7dd3fc : #64748b;
        font-size: 10px;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}


component FormField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    horizontal-stretch: 1;
    spacing: 4px;

    Text {
        text: root.label;
        color: #94a3b8;
        font-size: 11px;
    }
    Rectangle {
        height: 46px;
        border-radius: 12px;
        background: #0d1622;
        border-width: 1px;
        border-color: #1e3a5f;

        TextInput {
            x: 12px;
            y: 0;
            width: parent.width - 24px;
            height: 100%;
            text <=> root.text;
            single-line: true;
            color: #f8fafc;
            font-size: 14px;
        }
    }
}

component ChoiceChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    horizontal-stretch: 1;
    height: 38px;
    border-radius: 12px;
    background: root.active ? #0e3a5f : #0d1622;
    border-width: 1px;
    border-color: root.active ? #38bdf8 : #1e3a5f;

    Text {
        text: root.label;
        color: root.active ? #7dd3fc : #94a3b8;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}


component MacroPill inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <color> accent: #7dd3fc;

    horizontal-stretch: 1;
    height: 58px;
    border-radius: 12px;
    background: #0d1622;
    border-width: 1px;
    border-color: #1e293b;

    VerticalLayout {
        padding: 8px;
        spacing: 1px;
        Text {
            text: "\{root.value}";
            color: root.accent;
            font-size: 18px;
            font-weight: 700;
        }
        Text {
            text: root.label;
            color: #94a3b8;
            font-size: 9px;
        }
    }
}

export component AppWindow inherits Window {
    in-out property <int> tab: 0;
    in-out property <int> water: 0;
    in-out property <int> sleep: 0;
    in-out property <int> steps: 0;
    in-out property <int> protein: 0;
    in-out property <string> user-name: "Friend";
    in-out property <bool> loading: false;
    in-out property <string> status-text: "Connect your account to sync today's log.";
    in-out property <bool> signed-in: false;
    in-out property <string> auth-token: "";
    in-out property <string> auth-error: "";
    in-out property <bool> google-busy: false;
    in-out property <string> device-user-code: "";
    in-out property <string> device-url: "";
    in-out property <string> auth-status: "";
    in-out property <string> profile-name: "Friend";
    in-out property <string> profile-email: "";
    in-out property <int> profile-age: 0;
    in-out property <int> profile-height: 0;
    in-out property <int> profile-weight: 0;
    in-out property <string> profile-goal: "";
    in-out property <string> profile-diet: "";
    in-out property <string> profile-place: "";
    in-out property <string> profile-experience: "";
    in-out property <int> profile-days: 0;
    in-out property <int> profile-budget: 0;
    in-out property <string> profile-tier: "Free";
    in-out property <bool> needs-onboarding: false;
    in-out property <string> form-name: "";
    in-out property <string> form-age: "22";
    in-out property <string> form-gender: "male";
    in-out property <string> form-height: "170";
    in-out property <string> form-weight: "65";
    in-out property <string> form-goal: "muscle_gain";
    in-out property <string> form-place: "gym";
    in-out property <string> form-experience: "beginner";
    in-out property <string> form-diet: "veg";
    in-out property <string> form-days: "4";
    in-out property <string> form-budget: "150";
    in-out property <string> form-error: "";
    in-out property <[MealItem]> nutrition-meals: [];
    in-out property <string> nutrition-title: "";
    in-out property <string> nutrition-status: "Load today's meal plan.";
    in-out property <int> target-calories: 0;
    in-out property <int> target-protein: 0;
    in-out property <int> target-carbs: 0;
    in-out property <int> target-fat: 0;

    callback refresh();
    callback sign-in();
    callback google-sign-in();
    callback load-profile();
    callback sign-out();
    callback save-onboarding();
    callback skip-onboarding();
    callback load-nutrition();
    callback add-water();
    callback add-steps();
    callback add-protein();
    callback set-tab(int);

    width: 390px;
    height: 844px;
    background: #070b10;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: "FITMENTOR";
                    color: #38bdf8;
                    font-size: 11px;
                    font-weight: 700;
                }
                Text {
                    text: "Good morning, \{root.user-name}";
                    color: #f8fafc;
                    font-size: 24px;
                    font-weight: 700;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                background: #0f2233;
                border-width: 1px;
                border-color: #1e3a5f;

                Text {
                    text: "\{root.water}";
                    color: #7dd3fc;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if root.tab == 0 : VerticalLayout {
            spacing: 12px;

            VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    StatCard {
                        title: "Water";
                        value: "\{root.water} glasses";
                        accent: #38bdf8;
                    }
                    StatCard {
                        title: "Sleep";
                        value: "\{root.sleep} hours";
                        accent: #a78bfa;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    StatCard {
                        title: "Steps";
                        value: "\{root.steps}";
                        accent: #34d399;
                    }
                    StatCard {
                        title: "Protein";
                        value: "\{root.protein} g";
                        accent: #fbbf24;
                    }
                }
            }

            Rectangle {
                border-radius: 18px;
                background: #0d1622;
                border-width: 1px;
                border-color: #1e293b;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text {
                        text: "Quick log";
                        color: #f8fafc;
                        font-size: 15px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        QuickButton {
                            label: "+250 ml";
                            clicked => {
                                root.add-water();
                            }
                        }
                        QuickButton {
                            label: "+1000 steps";
                            clicked => {
                                root.add-steps();
                            }
                        }
                        QuickButton {
                            label: "+10g protein";
                            clicked => {
                                root.add-protein();
                            }
                        }
                    }
                }
            }

            Rectangle {
                border-radius: 18px;
                background: #0d1622;
                border-width: 1px;
                border-color: #1e293b;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text {
                        text: root.status-text;
                        color: #94a3b8;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    QuickButton {
                        label: root.loading ? "Syncing..." : "Refresh from API";
                        clicked => {
                            root.refresh();
                        }
                    }
                }
            }
        }

        if root.tab == 1 : VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "FUEL";
                        color: #38bdf8;
                        font-size: 11px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Nutrition";
                        color: #f8fafc;
                        font-size: 28px;
                        font-weight: 700;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                QuickButton {
                    label: "Refresh";
                    clicked => {
                        root.load-nutrition();
                    }
                }
            }

            Text {
                text: root.nutrition-status;
                color: #94a3b8;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                MacroPill {
                    label: "kcal";
                    value: root.target-calories;
                    accent: #fbbf24;
                }
                MacroPill {
                    label: "protein";
                    value: root.target-protein;
                    accent: #34d399;
                }
                MacroPill {
                    label: "carbs";
                    value: root.target-carbs;
                    accent: #38bdf8;
                }
                MacroPill {
                    label: "fat";
                    value: root.target-fat;
                    accent: #a78bfa;
                }
            }

            ScrollView {
                height: 430px;

                VerticalLayout {
                    width: 100%;
                    spacing: 8px;

                    if root.nutrition-meals.length == 0 : Text {
                        text: "No meal plan yet. The daily planner will fill this after it runs.";
                        color: #64748b;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    for meal in root.nutrition-meals : Rectangle {
                        border-radius: 14px;
                        background: #0d1622;
                        border-width: 1px;
                        border-color: #1e293b;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 3px;

                            HorizontalLayout {
                                Text {
                                    text: meal.name;
                                    color: #f8fafc;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "\{meal.kcal} kcal";
                                    color: #fbbf24;
                                    font-size: 11px;
                                }
                            }
                            Text {
                                text: meal.items;
                                color: #94a3b8;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "\{meal.protein} g protein";
                                color: #34d399;
                                font-size: 10px;
                            }
                        }
                    }
                }
            }
        }

        if root.tab == 2 : VerticalLayout {
            spacing: 8px;
            Text {
                text: "Workouts";
                color: #f8fafc;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                text: "The workout plan and completion flow will live here.";
                color: #94a3b8;
                font-size: 14px;
                wrap: word-wrap;
            }
        }

        if root.tab == 3 : VerticalLayout {
            spacing: 8px;
            Text {
                text: "Coach";
                color: #f8fafc;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                text: "Chat with FitMentor AI is next.";
                color: #94a3b8;
                font-size: 14px;
                wrap: word-wrap;
            }
        }

        if root.tab == 4 : VerticalLayout {
            spacing: 10px;

            Text {
                text: root.profile-name;
                color: #f8fafc;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                text: root.profile-email;
                color: #94a3b8;
                font-size: 13px;
            }

            Rectangle {
                border-radius: 16px;
                background: #0d1622;
                border-width: 1px;
                border-color: #1e293b;

                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;

                    Text {
                        text: "Current plan";
                        color: #94a3b8;
                        font-size: 11px;
                    }
                    Text {
                        text: root.profile-tier;
                        color: #fbbf24;
                        font-size: 24px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Goal: \{root.profile-goal}  ·  \{root.profile-diet}  ·  \{root.profile-days}x/week";
                        color: #94a3b8;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                StatCard {
                    title: "Age";
                    value: "\{root.profile-age} yrs";
                    accent: #38bdf8;
                }
                StatCard {
                    title: "Height";
                    value: "\{root.profile-height} cm";
                    accent: #a78bfa;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                StatCard {
                    title: "Weight";
                    value: "\{root.profile-weight} kg";
                    accent: #34d399;
                }
                StatCard {
                    title: "Budget";
                    value: "₹\{root.profile-budget}/day";
                    accent: #fbbf24;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                QuickButton {
                    label: "Refresh profile";
                    clicked => {
                        root.load-profile();
                    }
                }
                QuickButton {
                    label: "Sign out";
                    clicked => {
                        root.sign-out();
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            height: 64px;
            border-radius: 20px;
            background: #0b1420;
            border-width: 1px;
            border-color: #1e293b;

            HorizontalLayout {
                padding: 6px;
                spacing: 2px;

                NavItem {
                    label: "Today";
                    active: root.tab == 0;
                    clicked => {
                        root.set-tab(0);
                    }
                }
                NavItem {
                    label: "Food";
                    active: root.tab == 1;
                    clicked => {
                        root.set-tab(1);
                    }
                }
                NavItem {
                    label: "Train";
                    active: root.tab == 2;
                    clicked => {
                        root.set-tab(2);
                    }
                }
                NavItem {
                    label: "Coach";
                    active: root.tab == 3;
                    clicked => {
                        root.set-tab(3);
                    }
                }
                NavItem {
                    label: "You";
                    active: root.tab == 4;
                    clicked => {
                        root.set-tab(4);
                    }
                }
            }
        }
    }
    if !root.signed-in : Rectangle {
        background: #070b10;

        VerticalLayout {
            padding: 24px;
            spacing: 12px;

            Rectangle {
                vertical-stretch: 1;
            }

            Text {
                text: "FITMENTOR";
                color: #38bdf8;
                font-size: 11px;
                font-weight: 700;
            }
            Text {
                text: "Connect your account";
                color: #f8fafc;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                text: "Sign in with Google on this device, or paste a mobile token if you already have one.";
                color: #94a3b8;
                font-size: 13px;
                wrap: word-wrap;
            }

            QuickButton {
                label: root.google-busy ? "Waiting for Google..." : "Sign in with Google";
                clicked => {
                    root.google-sign-in();
                }
            }

            if root.device-user-code != "" : VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Open this link on any device:";
                    color: #94a3b8;
                    font-size: 12px;
                }
                Text {
                    text: root.device-url;
                    color: #7dd3fc;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.device-user-code;
                    color: #f8fafc;
                    font-size: 30px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Then approve the code in your browser.";
                    color: #94a3b8;
                    font-size: 12px;
                }
            }

            Text {
                text: root.auth-status;
                color: #7dd3fc;
                font-size: 12px;
                wrap: word-wrap;
            }

            Text {
                text: "or paste a mobile token";
                color: #64748b;
                font-size: 11px;
            }

            Rectangle {
                height: 52px;
                border-radius: 14px;
                background: #0d1622;
                border-width: 1px;
                border-color: #1e3a5f;

                TextInput {
                    x: 12px;
                    y: 0;
                    width: parent.width - 24px;
                    height: 100%;
                    text <=> root.auth-token;
                    single-line: true;
                    color: #f8fafc;
                    font-size: 13px;
                }
            }

            QuickButton {
                label: "Continue";
                clicked => {
                    root.sign-in();
                }
            }

            Text {
                text: root.auth-error;
                color: #f87171;
                font-size: 12px;
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }
    }

    if root.needs-onboarding : Rectangle {
        background: #070b10;

        ScrollView {
            width: 100%;
            height: 100%;

            VerticalLayout {
                width: 100%;
                padding: 24px;
                spacing: 10px;

                Text {
                    text: "Set up your profile";
                    color: #f8fafc;
                    font-size: 28px;
                    font-weight: 700;
                }
                Text {
                    text: "This powers your meal plan, workouts, and targets.";
                    color: #94a3b8;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                FormField {
                    label: "Name";
                    text <=> root.form-name;
                }
                HorizontalLayout {
                    spacing: 10px;
                    FormField {
                        label: "Age";
                        text <=> root.form-age;
                    }
                    FormField {
                        label: "Height (cm)";
                        text <=> root.form-height;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    FormField {
                        label: "Weight (kg)";
                        text <=> root.form-weight;
                    }
                    FormField {
                        label: "Days / week";
                        text <=> root.form-days;
                    }
                }
                FormField {
                    label: "Food budget (INR / day)";
                    text <=> root.form-budget;
                }

                Text {
                    text: "Gender";
                    color: #94a3b8;
                    font-size: 11px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    ChoiceChip {
                        label: "Male";
                        active: root.form-gender == "male";
                        clicked => {
                            root.form-gender = "male";
                        }
                    }
                    ChoiceChip {
                        label: "Female";
                        active: root.form-gender == "female";
                        clicked => {
                            root.form-gender = "female";
                        }
                    }
                    ChoiceChip {
                        label: "Other";
                        active: root.form-gender == "other";
                        clicked => {
                            root.form-gender = "other";
                        }
                    }
                }

                Text {
                    text: "Goal";
                    color: #94a3b8;
                    font-size: 11px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    ChoiceChip {
                        label: "Muscle";
                        active: root.form-goal == "muscle_gain";
                        clicked => {
                            root.form-goal = "muscle_gain";
                        }
                    }
                    ChoiceChip {
                        label: "Fat loss";
                        active: root.form-goal == "fat_loss";
                        clicked => {
                            root.form-goal = "fat_loss";
                        }
                    }
                    ChoiceChip {
                        label: "Strength";
                        active: root.form-goal == "strength";
                        clicked => {
                            root.form-goal = "strength";
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    ChoiceChip {
                        label: "Recomp";
                        active: root.form-goal == "recomp";
                        clicked => {
                            root.form-goal = "recomp";
                        }
                    }
                    ChoiceChip {
                        label: "Stay fit";
                        active: root.form-goal == "general";
                        clicked => {
                            root.form-goal = "general";
                        }
                    }
                }

                Text {
                    text: "Where do you train?";
                    color: #94a3b8;
                    font-size: 11px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    ChoiceChip {
                        label: "Gym";
                        active: root.form-place == "gym";
                        clicked => {
                            root.form-place = "gym";
                        }
                    }
                    ChoiceChip {
                        label: "Home";
                        active: root.form-place == "home";
                        clicked => {
                            root.form-place = "home";
                        }
                    }
                }

                Text {
                    text: "Experience";
                    color: #94a3b8;
                    font-size: 11px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    ChoiceChip {
                        label: "Beginner";
                        active: root.form-experience == "beginner";
                        clicked => {
                            root.form-experience = "beginner";
                        }
                    }
                    ChoiceChip {
                        label: "Intermediate";
                        active: root.form-experience == "intermediate";
                        clicked => {
                            root.form-experience = "intermediate";
                        }
                    }
                    ChoiceChip {
                        label: "Advanced";
                        active: root.form-experience == "advanced";
                        clicked => {
                            root.form-experience = "advanced";
                        }
                    }
                }

                Text {
                    text: "Diet";
                    color: #94a3b8;
                    font-size: 11px;
                }
                HorizontalLayout {
                    spacing: 6px;
                    ChoiceChip {
                        label: "Veg";
                        active: root.form-diet == "veg";
                        clicked => {
                            root.form-diet = "veg";
                        }
                    }
                    ChoiceChip {
                        label: "Non-veg";
                        active: root.form-diet == "nonveg";
                        clicked => {
                            root.form-diet = "nonveg";
                        }
                    }
                    ChoiceChip {
                        label: "Egg";
                        active: root.form-diet == "egg";
                        clicked => {
                            root.form-diet = "egg";
                        }
                    }
                }

                Text {
                    text: root.form-error;
                    color: #f87171;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                QuickButton {
                    label: "Save profile";
                    clicked => {
                        root.save-onboarding();
                    }
                }
                QuickButton {
                    label: "Skip for now";
                    clicked => {
                        root.skip-onboarding();
                    }
                }

                Rectangle {
                    height: 24px;
                }
            }
        }
    }

}
