# =============================================================================
# FitMentor — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.

# --- Database (RDS) ---
DATABASE_URL=postgresql://fitmentor_app:CHANGE_ME@your-cluster.cockroachlabs.cloud:26257/fitmentor?sslmode=verify-full

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API Shared Secret (server-to-server auth) ---
# Generate with: openssl rand -hex 32
API_SHARED_SECRET=

# --- OAuth (set in Cloudflare Pages dashboard, not here) ---
# Google: https://console.cloud.google.com → APIs & Services → Credentials → OAuth Client (Web)
# Redirect URI: https://<pages-domain>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Session ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- App URLs ---
APP_URL=https://your-pages-domain.pages.dev
API_URL=https://your-function-url.lambda-url.ap-south-1.on.aws

# --- Cloudflare ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-aud-tag

# --- R2 (media storage) ---
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_HOST=

# --- AI ---
AI_WORKER_URL=https://your-pages-domain.pages.dev/api/ai/complete
SUPERMEMORY_API_KEY=

# --- Payments (Polar) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PREMIUM_PRODUCT_ID=
POLAR_PREMIUM_PRICE_ID=
POLAR_PRO_PRODUCT_ID=
POLAR_API_BASE=https://api.polar.sh
POLAR_PRO_PRICE_ID=
# Mobile auth
JWT_SECRET=
JWT_TTL_DAYS=30
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_WEB_REDIRECT_URI=https://vfvwjpw567ghnqwknc2m74thx40jmpiw.lambda-url.ap-south-1.on.aws/v1/auth/google/callback
